        {
          "@id": "#step-async-put"
        },
        {
          "@id": "#step-async-wait"
        },
        {
          "@id": "#step-async-get"
        }
      ]
    },
    {
      "@id": "#acceptance-test-sync",
      "@type": "HowTo",
      "name": "Synchronous CLI acceptance test",
      "description": "Execute the service locally with the sample input and validate the output string.",
      "tool": [
        {
          "@id": "#tool-oscar-cli"
        }
      ],
      "supply": [
        {
          "@id": "#supply-input-jpg"
        }
      ],
      "step": [
        {
          "@id": "#step-sync-run"
        }
      ]
    },
    {
      "@id": "#tool-oscar-cli",
      "@type": "HowToTool",
      "name": "OSCAR CLI",
      "item": {
        "@id": "#oscar-cli"
      }
    },
    {
      "@id": "#supply-sample-image",
      "@type": "HowToSupply",
      "name": "Sample classification image",
      "item": {
        "@id": "input.jpg"
      }
    },
    {
      "@id": "#supply-input-jpg",
      "@type": "HowToSupply",
      "name": "Sample classification image",
      "item": {
        "@id": "input.jpg"
      }
    },
    {
      "@id": "#expected-json",
      "@type": [
        "File"
      ],
      "name": "Expected classification output",
      "description": "JSON file produced by the service containing classification results.",
      "encodingFormat": "text/plain"
    },
    {
      "@id": "#step-sync-run",
      "@type": "HowToStep",
      "position": 1,
      "text": "Run the service using the provided sample input.",
      "potentialAction": {
        "@id": "#action-sync-run"
      }
    },
    {
      "@id": "#entry-sync-run",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#oscar-cli"
      }
    },
    {
      "@id": "#command-template-sync-run",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service run phyto-plankton-classifier -i {input}"
    },
    {
      "@id": "#step-async-put",
      "@type": "HowToStep",
      "position": 1,
      "text": "Upload the sample classification image to the service storage.",
      "potentialAction": {
        "@id": "#action-async-put"
      }
    },
    {
      "@id": "#step-async-wait",
      "@type": "HowToStep",
      "position": 2,
      "text": "Wait for the remote inference to produce classification outputs.",
      "timeRequired": "PT20S"
    },
    {
      "@id": "#step-async-get",
      "@type": "HowToStep",
      "position": 3,
      "text": "Download the most recent output artifact and confirm it is the expected classification JSON.",
      "potentialAction": {
        "@id": "#action-async-get"
      }
    },
    {
      "@id": "#action-sync-run",
      "@type": "ConsumeAction",
      "name": "Run service synchronously",
      "object": {
        "@id": "input.jpg"
      },
      "target": {
        "@id": "#entry-sync-run"
      },
      "result": {
        "@id": "#expected-json"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-sync-run"
        }
      ]
    },
    {
      "@id": "#action-async-put",
      "@type": "TransferAction",
      "name": "service put-file",
      "object": {
        "@id": "input.jpg"
      },
      "target": {
        "@id": "#entry-async-put"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-async-put"
        }
      ]
    },
    {
      "@id": "#entry-async-put",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#oscar-cli"
      }
    },
    {
      "@id": "#command-template-async-put",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service put-file phyto-plankton-classifier {source}"
    },
    {
      "@id": "#action-async-get",
      "@type": "TransferAction",
      "name": "service get-file",
      "target": {
        "@id": "#entry-async-get"
      },
      "result": {
        "@id": "#expected-json"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-async-get"
        }
      ]
    },
    {
      "@id": "#entry-async-get",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#oscar-cli"
      }
    },
    {
      "@id": "#command-template-async-get",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service get-file phyto-plankton-classifier --download-latest-into {destination}"
    },
