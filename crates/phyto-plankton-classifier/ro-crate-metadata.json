{
  "@context": ["https://w3id.org/ro/crate/1.2/context"],
  "@graph": [
    {
      "@id": "ro-crate-metadata.json",
      "@type": "CreativeWork",
      "conformsTo": {"@id": "https://w3id.org/ro/crate/1.2"},
      "about": {"@id": "./"}
    },
    {
      "@id": "./",
      "@type": ["Dataset", "Service", "SoftwareApplication"],
      "name": "Phytoplankton Classifier",
      "description": "OSCAR service wrapping the AI4OS phytoplankton classifier for synchronous and MinIO-triggered image classification. Its script calls predict_data with an UploadedFile to work around upstream CLI file-argument incompatibility.",
      "image": {"@id": "icon.png"},
      "url": "https://github.com/grycap/oscar-hub/tree/main/crates/phyto-plankton-classifier",
      "datePublished": "2026-09-28",
      "version": "0.1.0",
      "license": {"@id": "https://www.gnu.org/licenses/agpl-3.0.html"},
      "applicationCategory": "OSCAR Service",
      "memoryRequirements": "4 GiB",
      "processorRequirements": ["1 vCPU", "0 GPU"],
      "serviceType": ["synchronous", "asynchronous"],
      "keywords": ["phytoplankton", "classification", "AI4EOSC", "iMagine"],
      "isBasedOn": [
        {"@id": "https://github.com/ai4os-hub/phyto-plankton-classification"},
        {"@id": "https://github.com/grycap/oscar-clusters/tree/main/imagine/phyto-plankton-classifier"}
      ],
      "author": {"@id": "#author"},
      "hasPart": [
        {"@id": "fdl.yml"},
        {"@id": "script.sh"},
        {"@id": "README.md"},
        {"@id": "icon.png"},
        {"@id": "sample.jpg"},
        {"@id": "#prediction-output"}
      ],
      "subjectOf": [{"@id": "#acceptance-sync"}, {"@id": "#acceptance-async"}]
    },
    {"@id": "fdl.yml", "@type": ["File", "SoftwareSourceCode"], "name": "OSCAR FDL", "encodingFormat": "text/yaml"},
    {"@id": "script.sh", "@type": ["File", "SoftwareSourceCode"], "name": "Prediction script", "encodingFormat": "text/x-shellscript"},
    {"@id": "README.md", "@type": ["File", "TextDigitalDocument"], "name": "Deployment and validation notes", "encodingFormat": "text/markdown"},
    {"@id": "icon.png", "@type": ["File", "ImageObject"], "name": "Phytoplankton classifier icon", "description": "Original stylized diatom inside image-recognition brackets, representing aquatic microscopy and automated classification.", "encodingFormat": "image/png"},
    {"@id": "sample.jpg", "@type": ["File", "ImageObject"], "name": "Sample phytoplankton image", "encodingFormat": "image/jpeg"},
    {"@id": "#prediction-output", "@type": "Dataset", "name": "Generated prediction JSON"},
    {"@id": "#expected-async-prediction", "@type": "PropertyValue", "name": "Asynchronous prediction content", "value": "\"pred_lab\""},
    {
      "@id": "#acceptance-sync", "@type": "HowTo", "name": "Synchronous classification",
      "description": "Invoke the model with the sample image and verify the synchronous response; a separate decoded JSON check verifies its content.",
      "tool": [{"@id": "#tool-cli"}], "supply": [{"@id": "#supply-image"}],
      "step": [{"@id": "#step-sync"}]
    },
    {
      "@id": "#acceptance-async", "@type": "HowTo", "name": "Asynchronous classification",
      "description": "Upload the sample image; wait for the bucket-triggered job and retrieve its output.",
      "tool": [{"@id": "#tool-cli"}], "supply": [{"@id": "#supply-image"}],
      "step": [{"@id": "#step-put"}, {"@id": "#step-wait"}, {"@id": "#step-get"}]
    },
    {"@id": "#tool-cli", "@type": "HowToTool", "name": "OSCAR CLI", "item": {"@id": "#oscar-cli"}},
    {"@id": "#oscar-cli", "@type": "SoftwareApplication", "name": "OSCAR CLI", "url": "https://github.com/grycap/oscar-cli", "version": "devel"},
    {"@id": "#supply-image", "@type": "HowToSupply", "name": "Sample image", "item": {"@id": "sample.jpg"}},
    {"@id": "#step-sync", "@type": "HowToStep", "position": 1, "text": "Call the service synchronously.", "potentialAction": {"@id": "#action-sync"}},
    {"@id": "#step-put", "@type": "HowToStep", "position": 1, "text": "Upload to the service input prefix.", "potentialAction": {"@id": "#action-put"}},
    {"@id": "#step-wait", "@type": "HowToStep", "position": 2, "text": "Wait for Kueue admission, model initialization, and classification.", "timeRequired": "PT150S"},
    {"@id": "#step-get", "@type": "HowToStep", "position": 3, "text": "Retrieve the newest prediction output.", "potentialAction": {"@id": "#action-get"}},
    {
      "@id": "#action-sync", "@type": "ConsumeAction", "name": "service run", "object": {"@id": "sample.jpg"},
      "target": {"@id": "#entry-sync"}, "result": {"@id": "#prediction-output"},
      "additionalProperty": [{"@id": "#template-sync"}]
    },
    {"@id": "#entry-sync", "@type": "EntryPoint", "actionApplication": {"@id": "#oscar-cli"}},
    {"@id": "#template-sync", "@type": "PropertyValue", "propertyID": "commandTemplate", "value": "oscar-cli service run phyto-plankton-classifier --file-input {input} --output {destination}"},
    {
      "@id": "#action-put", "@type": "TransferAction", "name": "service put-file", "object": {"@id": "sample.jpg"},
      "target": {"@id": "#entry-put"}, "additionalProperty": [{"@id": "#template-put"}]
    },
    {"@id": "#entry-put", "@type": "EntryPoint", "actionApplication": {"@id": "#oscar-cli"}},
    {"@id": "#template-put", "@type": "PropertyValue", "propertyID": "commandTemplate", "value": "oscar-cli service put-file phyto-plankton-classifier {source}"},
    {
      "@id": "#action-get", "@type": "TransferAction", "name": "service get-file",
      "target": {"@id": "#entry-get"}, "result": {"@id": "#expected-async-prediction"},
      "additionalProperty": [{"@id": "#template-get"}]
    },
    {"@id": "#entry-get", "@type": "EntryPoint", "actionApplication": {"@id": "#oscar-cli"}},
    {"@id": "#template-get", "@type": "PropertyValue", "propertyID": "commandTemplate", "value": "oscar-cli service get-file phyto-plankton-classifier --download-latest-into {destination}"},
    {"@id": "#author", "@type": "Organization", "name": "GRyCAP - Universitat Politècnica de València", "url": "https://www.grycap.upv.es/"},
    {"@id": "https://www.gnu.org/licenses/agpl-3.0.html", "@type": "CreativeWork", "name": "GNU Affero General Public License v3.0", "identifier": "SPDX:AGPL-3.0"},
    {"@id": "https://github.com/ai4os-hub/phyto-plankton-classification", "@type": "SoftwareApplication", "name": "Upstream model and image", "url": "https://github.com/ai4os-hub/phyto-plankton-classification", "version": "latest"},
    {"@id": "https://github.com/grycap/oscar-clusters/tree/main/imagine/phyto-plankton-classifier", "@type": "SoftwareApplication", "name": "iMagine OSCAR example", "url": "https://github.com/grycap/oscar-clusters/tree/main/imagine/phyto-plankton-classifier", "version": "main"}
  ]
}
