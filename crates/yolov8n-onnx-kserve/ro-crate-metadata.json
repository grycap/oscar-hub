      "name": "YOLOv8n ONNX KServe Inference Service",
      "description": "OSCAR service that deploys a YOLOv8n object detection model (exported to ONNX) as a KServe InferenceService. When an image is uploaded to the input bucket, the script preprocesses it, calls the KServe v2 inference endpoint, applies confidence filtering and non-maximum suppression, and writes the annotated results back to MinIO.",
      "license": {
        "@id": "https://www.apache.org/licenses/LICENSE-2.0"
      },
      "version": "1.0.0",
      "applicationCategory": "OSCAR-KServe Service",
      "memoryRequirements": "2 GiB",
      "processorRequirements": [
        "1 vCPU",
        "1 kserve-vCPU"
      ],
      "serviceType": [
        "asynchronous",
