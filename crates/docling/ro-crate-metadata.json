      "@id": "#acceptance-test-sync",
      "@type": "HowTo",
      "name": "Synchronous Docling acceptance test",
      "description": "Run the service synchronously with the sample Markdown document and verify that the converted Markdown contains its heading.",
      "tool": [
        {
          "@id": "#tool-oscar-cli"
        }
      ],
      "supply": [
        {
          "@id": "#supply-input-md"
        }
      ],
      "step": [
        {
          "@id": "#step-sync-run"
        }
      ]
    },
    {
      "@id": "#acceptance-test-async",
      "@type": "HowTo",
      "name": "Asynchronous Docling acceptance test",
      "description": "Upload the sample document to the service input path, wait for processing, and verify the Markdown output in the output path.",
      "tool": [
        {
          "@id": "#tool-oscar-cli"
        }
      ],
      "supply": [
        {
          "@id": "#supply-input-md"
        }
      ],
      "step": [
        {
          "@id": "#step-async-put"
        },
        {
          "@id": "#step-async-wait"
        },
        {
          "@id": "#step-async-get"
        }
      ]
    },
    {
      "@id": "#tool-oscar-cli",
      "@type": "HowToTool",
      "name": "OSCAR CLI",
      "item": {
        "@id": "#software-oscar-cli"
      }
    },
    {
      "@id": "#supply-input-md",
      "@type": "HowToSupply",
      "name": "Sample input document",
      "item": {
        "@id": "input.pdf"
      }
    },
    {
      "@id": "#expected-output-heading",
      "@type": "PropertyValue",
      "name": "expected output substring",
      "value": "Document Conversion Demonstration"
    },
    {
      "@id": "#expected-output-file",
      "@type": [
        "File",
        "TextDigitalDocument"
      ],
      "name": "Generated Markdown output",
      "description": "Markdown file with the same stem as the input document and an .md extension. OSCAR's storage backend exposes it with the text/plain media type.",
      "encodingFormat": "text/plain"
    },
    {
      "@id": "#step-sync-run",
      "@type": "HowToStep",
      "position": 1,
      "text": "Run the Docling service synchronously with the sample document.",
      "potentialAction": {
        "@id": "#action-sync-run"
      }
    },
    {
      "@id": "#step-async-put",
      "@type": "HowToStep",
      "position": 1,
      "text": "Upload the sample document to the Docling service input path.",
      "potentialAction": {
        "@id": "#action-async-put"
      }
    },
    {
      "@id": "#step-async-wait",
      "@type": "HowToStep",
      "position": 2,
      "text": "Wait for the asynchronous OSCAR job to complete.",
      "timeRequired": "PT60S"
    },
    {
      "@id": "#step-async-get",
      "@type": "HowToStep",
      "position": 3,
      "text": "Download the latest Markdown result from the service output path.",
      "potentialAction": {
        "@id": "#action-async-get"
      }
    },
    {
      "@id": "#action-sync-run",
      "@type": "ConsumeAction",
      "name": "Run Docling service synchronously",
      "object": {
        "@id": "input.pdf"
      },
      "target": {
        "@id": "#entry-sync-run"
      },
      "result": {
        "@id": "#expected-output-heading"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-sync-run"
        }
      ]
    },
    {
      "@id": "#entry-sync-run",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#software-oscar-cli"
      }
    },
    {
      "@id": "#command-template-sync-run",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service run docling --input {input}"
    },
    {
      "@id": "#action-async-put",
      "@type": "TransferAction",
      "name": "Upload sample document",
      "object": {
        "@id": "input.pdf"
      },
      "target": {
        "@id": "#entry-async-put"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-async-put"
        }
      ]
    },
    {
      "@id": "#entry-async-put",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#software-oscar-cli"
      }
    },
    {
      "@id": "#command-template-async-put",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service put-file docling {source}"
    },
    {
      "@id": "#action-async-get",
      "@type": "TransferAction",
      "name": "Download Markdown result",
      "target": {
        "@id": "#entry-async-get"
      },
      "result": {
        "@id": "#expected-output-file"
      },
      "additionalProperty": [
        {
          "@id": "#command-template-async-get"
        }
      ]
    },
    {
      "@id": "#entry-async-get",
      "@type": "EntryPoint",
      "actionApplication": {
        "@id": "#software-oscar-cli"
      }
    },
    {
      "@id": "#command-template-async-get",
      "@type": "PropertyValue",
      "propertyID": "commandTemplate",
      "value": "oscar-cli service get-file docling --download-latest-into {destination}"
    }
