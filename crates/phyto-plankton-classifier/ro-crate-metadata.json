      "encodingFormat": "image/jpeg"
    },
    {
      "@id": "#acceptance-test-async",
      "@type": "HowTo",
      "name": "Asynchronous Phyto-Plankton Classifier acceptance test",
      "description": "Upload a sample image, wait for classification to complete remotely, then download the prediction artifact and check the expected confirmation text.",
      "tool": [
        {
          "@id": "#tool-oscar-cli"
        }
      ],
      "supply": [
        {
          "@id": "#supply-sample-image"
        }
      ],
